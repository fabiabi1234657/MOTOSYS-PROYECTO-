      "post": {
        "tags": [
          "notification-controller"
        ],
        "operationId": "ingest",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Evento registrado"
          },
          "200": {
            "description": "Evento ya registrado"
          },
          "401": {
            "description": "Credencial interna inválida"
          },
          "409": {
            "description": "Idempotency-Key no coincide con el evento"
          }
        },
        "security": [
          {
