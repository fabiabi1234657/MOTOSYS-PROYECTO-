  "components": {
    "schemas": {
      "Request": {
        "type": "object",
        "properties": {
          "motorcycleId": {
            "type": "string",
            "format": "uuid"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "kilometers": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "motorcycleId"
        ]
      },
      "Reminder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "motorcycleId": {
            "type": "string"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "kilometers": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "MAINTENANCE",
              "EXPENSE"
            ]
          },
          "motorcycle_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "actor_id",
          "id",
          "kind",
          "motorcycle_id"
        ]
      },
      "Metadata": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fileHash": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Notice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "motorcycleId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "description": "Sesión opaca de MotoSys",
        "scheme": "bearer"
      },
      "serviceToken": {
        "type": "http",
        "description": "Credencial interna de entrega",
        "scheme": "bearer"
      },
      "webSession": {
        "type": "apiKey",
        "description": "Sesión Web. Envía X-CSRF-Token para mutaciones.",
        "name": "__Host-motosys",
        "in": "cookie"
      }
    }
  }
}
