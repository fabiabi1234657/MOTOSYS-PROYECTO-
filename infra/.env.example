# ==============================================================================
# MotoSys — Plantilla de Variables de Entorno (NO subir .env real a GitHub)
# Copiar este archivo a infra/.env y completar los valores antes de desplegar.
# ==============================================================================

# --- Red y Entorno ---
NODE_ENV=development
APP_ENV=local
EXTERNAL_NETWORK=motosys_net

# --- PostgreSQL 16 (Relacional ACID) ---
POSTGRES_DB=motosys
POSTGRES_USER=motosys_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MongoDB 7 (NoSQL Documental) ---
MONGO_INITDB_ROOT_USERNAME=motosys_mongo
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_STRONG_MONGO_PASS
MONGO_DB=motosys_docs
MONGO_HOST=mongodb
MONGO_PORT=27017

# --- Redis 7 (NoSQL Clave-Valor: Caché + Sesiones) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASS

# --- Apache Cassandra 4 (NoSQL Columnas Anchas: Odómetro + Auditoría) ---
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=motosys
CASSANDRA_DC=datacenter1

# --- ClickHouse 24.8 (Motor Analítico OLAP) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=motosys_analytics
CLICKHOUSE_USER=motosys_olap
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_CH_PASS

# --- RabbitMQ (Mensajería Asíncrona / Fallback Circuit Breaker) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=motosys_mq
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_MQ_PASS

# --- Seguridad, JWT y Sesiones ---
JWT_ACCESS_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_ACCESS_SECRET
JWT_ACCESS_TTL_SECONDS=900
SESSION_INACTIVITY_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
CSRF_SECRET=CHANGE_ME_RANDOM_CSRF_SECRET
COOKIE_SECURE=false

# --- Inicialización controlada del primer Superadministrador ---
SEED_SUPERADMIN_EMAIL=superadmin@motosys.local
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_MIN_15_CHARS_PASSPHRASE

# --- OpenID Connect (OAuth 2.0) — Proveedores Externos + Dev Mock ---
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
OIDC_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
OIDC_MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
OIDC_MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET

OIDC_DEV_ENABLED=true
OIDC_DEV_ISSUER=http://oidc-dev:8090
OIDC_DEV_CLIENT_ID=motosys-dev-client
OIDC_DEV_CLIENT_SECRET=motosys-dev-secret

# --- Puertos de Servicios ---
CORE_API_PORT=8081
NOTIFY_API_PORT=8082
ANALYTICS_API_PORT=8083
WEB_PORT=8080

# Core NestJS. Usa los mismos secretos de PostgreSQL y Redis codificados para URL.
DATABASE_URL=postgres://motosys:configure-password@postgres:5432/motosys
REDIS_URL=redis://:configure-password@redis:6379
TOTP_ENCRYPTION_KEY=
CORE_PORT=3000
PASSWORD_DENYLIST=

# OIDC externo. Configura un origen HTTPS y los clientes registrados.
OIDC_PUBLIC_ORIGIN=
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_ISSUER=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
DEV_OIDC_ISSUER=
DEV_OIDC_CLIENT_ID=
DEV_OIDC_CLIENT_SECRET=

# Perfil notifications. Codifica las credenciales de RABBITMQ_URL para URL.
NOTIFICATIONS_URL=
NOTIFICATIONS_TOKEN=
RABBITMQ_USER=motosys
RABBITMQ_PASSWORD=
RABBITMQ_URL=
# Fases 2B y 3
SMTP_URL=
RESET_PUBLIC_URL=
RESET_FROM=
CASSANDRA_HOST=cassandra
CASSANDRA_DC=datacenter1
CLICKHOUSE_URL=http://clickhouse:8123
MONGO_URL=mongodb://motosys:configure-password@mongo:27017/motosys?authSource=admin
JDBC_URL=jdbc:postgresql://postgres:5432/motosys
JDBC_USER=motosys
NOTIFY_PORT=3001